# Admin Dashboard - Profile Manager

# Web UI Auth
JWT_SECRET=your-super-secret-key-change-this
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
PORT=3002

# Sessions directory
SESSIONS_DIR=./sessions

# CORS - danh sách origin được phép (phân cách bằng dấu phẩy, bỏ trống = cho phép tất cả)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Headless mode - set to true for servers without display (auto-detected on Linux if DISPLAY is not set)
# HEADLESS=true
