# Admin Dashboard - Profile Manager

# Web UI Auth
JWT_SECRET=your-super-secret-key-change-this
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
PORT=3002

# Sessions directory
SESSIONS_DIR=./sessions

# Windows browser worker
WORKER_SERVER_URL=wss://ytb.voucheryoutube.vn
WORKER_AUTH_TOKEN=replace-with-the-same-token-as-the-server
USE_STUDIO_INTERNAL_API=0
USE_DIRECT_SHOPEE_AFFILIATE=0
USE_DIRECT_LAZADA_AFFILIATE=0
USE_PROVIDED_LAZADA_AFFILIATE_FALLBACK=0
ENABLE_BROWSER_PUBLIC_FALLBACK=1

# CORS - danh sách origin được phép (phân cách bằng dấu phẩy, bỏ trống = cho phép tất cả)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
