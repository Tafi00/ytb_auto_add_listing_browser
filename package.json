{
  "name": "ytb-auto-add-listing-browser",
  "version": "1.0.31",
  "description": "Browser-only worker for automating YouTube Shopping affiliate product listings.",
  "private": true,
  "author": "Tafi00",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tafi00/ytb_auto_add_listing_browser.git"
  },
  "bugs": {
    "url": "https://github.com/Tafi00/ytb_auto_add_listing_browser/issues"
  },
  "homepage": "https://github.com/Tafi00/ytb_auto_add_listing_browser#readme",
  "keywords": [
    "youtube-shopping",
    "affiliate-automation",
    "browser-automation",
    "playwright",
    "worker"
  ],
  "main": "src/launcher.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "dev": "concurrently \"npm run server\" \"npm run dev:web\"",
    "server": "node src/server.js",
    "dev:web": "npm run dev:client --prefix web",
    "worker": "node src/worker.js",
    "android-worker": "python -m android_worker.worker --config android-worker.json",
    "test:android": "python -m unittest discover -s tests -p \"test_android_*.py\"",
    "test:studio-api": "node --test tests/studio-internal-api.test.mjs tests/web-response.test.mjs",
    "launcher": "electron src/launcher.js",
    "api-tool": "electron src/studio-api-launcher.js",
    "api-worker": "node scripts/start-studio-api-worker.mjs",
    "build-api-tool": "electron-builder --win portable --x64 --config electron-builder.api.yml && node scripts/copy-studio-api-config.mjs",
    "prepare-standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-standalone.ps1",
    "build-launcher": "electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "playwright": "^1.40.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ytauto.browser-worker",
    "productName": "YouTube Auto Listing - Browser Worker",
    "asar": false,
    "win": {
      "target": "portable"
    },
    "files": [
      "src/launcher.js",
      "src/launcher.html",
      "src/worker.js",
      "src/studio-internal-api.js",
      "src/studio-api-launcher.js",
      "src/studio-api-launcher.html",
      "src/config.js",
      "src/logger.js",
      "android-worker.example.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": "../.env"
      }
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
